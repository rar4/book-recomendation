
@page "/"
@using Microsoft.AspNetCore.Components

<PageTitle>Feed</PageTitle>

<div class=" container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="shade card shadow-sm">
                <div class="row g-0">
                    
                    <!-- Book cover -->
                    <div class="col-md-4">
                        <img id="cover" src=""
                             class="img-fluid w-50 h-auto rounded-start"
                             alt="Book cover">
                    </div>

                    <!-- Book info -->
                    <div class="col-md-8">
                        <div class="card-body">
                            <h4 id="title" class="card-title"></h4>

                            <p class="card-text mb-1">
                                <strong>Author:</strong> <span id="author"></span>
                            </p>

                            <p class="card-text mb-1">
                                <strong>Published:</strong> <span id="date"></span>
                            </p>

                            <p class="card-text mb-1">
                                <strong>ISBN:</strong> <span id="isbn"></span>
                            </p>

                            <p class="card-text mt-3 text-muted">
                                <span id="description"></span>
                            </p>

                            <!-- Rating -->
                            <div class="mt-3">
                                @for (byte i = 1; i <= 5; i++)
                                {
                                    <span rating="@i" class="bookStar"
                                         >
                                        ★
                                    </span>
                                }
                            </div>

                            <button id="rate" class="btn btn-primary btn-sm mt-3">
                                Rate
                            </button>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .bookStar {
        font-size: 1.7rem;
        cursor: pointer;
        color: #adb5bd;
        user-select: none;
    }

    .yellow {
        color: #ffc800;
    }

    body{
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .outer{
        max-height: 100vh;
    }

    #description{
        overflow: scroll;
    }
</style>





<script>
fetch("http://localhost:5207/api/feed")
.then(response => {
    if (!response.ok)
    {
        alert("Error, try again later.")
    }
    return response.json();
})
.then(data => {
    if(data.title == null){
        fetch("api/dberror").then(setTimeout(() => {location.reload();}, 1500) );
    }
    let thumbnail;
    try{
        thumbnail = data.imageLinks.thumbnail;
    }
    catch{
        thumbnail = "https://external-content.duckduckgo.com/iu/?u=https%3A%2F%2Fsboxsolo.libretexts.org%2Fsites%2Fdefault%2Ffiles%2Fdefault_images%2Fdefault_book.jpg&f=1&nofb=1&ipt=75844788720e827dad9ecc9ac72ef6bc166b2eeb59c9d31468ba0059daa328cf";
    }
    document.querySelector("#cover").setAttribute("src", thumbnail);
    document.querySelector("#author").innerHTML = data.author;
    document.querySelector("#title").innerHTML = data.title;
    document.querySelector("#description").innerHTML = data.description;
    document.querySelector("#date").innerHTML = data.publishedDate;
    try{
    document.querySelector("#isbn").innerHTML = data.industryIdentifiers[0].identifier;
    }
    catch
    {
        document.querySelector("#isbn").innerHTML = "None";
    }
    document.querySelector("#rate").onclick = () => {
        sendRating(data.bookId)
        
    }
    console.log(data);
});
let stars = document.querySelectorAll(".bookStar");
for (const star of stars) 
{
    star.addEventListener("click", () => 
    {
        for (const starRate of stars) 
        {
            starRate.classList.remove("yellow");
        }
        for (const starRate of stars) 
        {
            if (star.getAttribute("rating") >= starRate.getAttribute("rating")) 
            {
                starRate.classList.add("yellow");
                
            }
        }
    })
}
function sendRating(id)
{
    let rate = 0;
    let ratingStars = document.querySelectorAll('.bookStar');
    for (const element of ratingStars) 
    {
        if (element.classList.contains('yellow')) 
        rate += 1;
        else break;
    }
    if (rate > 0 && rate < 6) {
        fetch(`api/rate?rating=${rate}&id=${id}`, {method: "POST"}).then(() =>{
        location.reload();
        });
    }
}



</script>

